{
    "info": {
      "name": "SGS Orders Worker — API Tests",
      "_postman_id": "sgs-orders-worker-v1",
      "description": "Full test suite for the SGS Orders Cloudflare Worker.\n\nSetup:\n1. Create a Postman Environment called 'SGS Orders Production'\n2. Set variable: base_url = https://sgs-orders-worker.<your-subdomain>.workers.dev\n3. Set variable: auth_token = (paste a valid Supabase JWT here)\n4. order_id and item_id are auto-filled by test scripts.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "base_url",   "value": "https://sgs-orders-worker.<your-subdomain>.workers.dev" },
      { "key": "auth_token", "value": "" },
      { "key": "order_id",   "value": "" },
      { "key": "item_id",    "value": "" }
    ],
    "item": [
      {
        "name": "🟢 Health",
        "item": [
          {
            "name": "GET /health — full status",
            "request": {
              "method": "GET",
              "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
            },
            "event": [{
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 200 or 207', () => pm.expect([200,207]).to.include(pm.response.code));",
                "const json = pm.response.json();",
                "pm.test('Has status field', () => pm.expect(json.status).to.be.oneOf(['ok','degraded']));",
                "pm.test('Has service name', () => pm.expect(json.service).to.eql('sgs-orders-worker'));",
                "pm.test('Has timestamp', () => pm.expect(json.timestamp).to.be.a('string'));",
                "pm.test('Has checks object', () => pm.expect(json.checks).to.be.an('object'));",
                "pm.test('Supabase check present', () => pm.expect(json.checks.supabase).to.be.a('string'));",
                "pm.test('S3 check present', () => pm.expect(json.checks.s3).to.be.a('string'));",
                "pm.test('Gmail check present', () => pm.expect(json.checks.gmail).to.be.a('string'));",
                "console.log('Health:', JSON.stringify(json, null, 2));"
              ]}
            }]
          }
        ]
      },
      {
        "name": "📦 Orders",
        "item": [
          {
            "name": "POST /orders — create (single product)",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type",  "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{auth_token}}" }
              ],
              "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
              "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Raj Mehta\",\n  \"phone\": \"9876543210\",\n  \"email\": \"raj@testcompany.com\",\n  \"payment_status\": \"Pending\",\n  \"delivery_timeline\": \"2025-09-15\",\n  \"products\": [\n    {\n      \"product_type\": \"MS Pipe\",\n      \"material\": \"Mild Steel\",\n      \"quantity\": 100,\n      \"unit\": \"KG\",\n      \"unit_cost\": 65,\n      \"sale_cost\": 6500,\n      \"cgst\": 585,\n      \"sgst\": 585,\n      \"description\": \"50mm diameter\"\n    }\n  ]\n}" }
            },
            "event": [{
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Has order id', () => pm.expect(json.id).to.be.a('string'));",
                "pm.test('Status is Order Received', () => pm.expect(json.status).to.eql('Order Received'));",
                "pm.test('Has tracking_token', () => pm.expect(json.tracking_token).to.be.a('string'));",
                "pm.collectionVariables.set('order_id', json.id);",
                "pm.collectionVariables.set('tracking_token', json.tracking_token);",
                "console.log('Saved order_id:', json.id, '| tracking_token:', json.tracking_token);"
              ]}
            }]
          },
          {
            "name": "POST /orders — create (multi product)",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type",  "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{auth_token}}" }
              ],
              "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
              "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Priya Shah\",\n  \"phone\": \"9123456789\",\n  \"email\": \"priya@example.com\",\n  \"payment_status\": \"Paid\",\n  \"delivery_timeline\": \"2025-10-01\",\n  \"products\": [\n    {\n      \"product_type\": \"MS Pipe\",\n      \"material\": \"Mild Steel\",\n      \"quantity\": 50,\n      \"unit\": \"KG\",\n      \"unit_cost\": 65,\n      \"sale_cost\": 3250,\n      \"cgst\": 292.5,\n      \"sgst\": 292.5\n    },\n    {\n      \"product_type\": \"MS Flat\",\n      \"material\": \"Mild Steel\",\n      \"quantity\": 30,\n      \"unit\": \"KG\",\n      \"unit_cost\": 72,\n      \"sale_cost\": 2160,\n      \"cgst\": 194.4,\n      \"sgst\": 194.4\n    }\n  ]\n}" }
            },
            "event": [{
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Has order id', () => pm.expect(pm.response.json().id).to.be.a('string'));"
              ]}
            }]
          },
          {
            "name": "POST /orders — missing customer_name (400)",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type",  "value": "application/json" },
