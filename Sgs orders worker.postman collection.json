              "script": { "exec": [
                "pm.test('Status 204', () => pm.response.to.have.status(204));",
                "pm.test('Allow-Origin header present', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.exist);",
                "pm.test('Allow-Methods includes POST', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));"
              ]}
            }]
